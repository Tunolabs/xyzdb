# The harness itself, as an image.
#
# WHY
# ---
# Step 0 pinned the rival SERVERS by digest and left the CLIENTS to whatever the
# host happened to have. On this machine that was a Python 3.9 venv, which caps
# `qdrant-client` at 1.16.1 against a pinned 1.18.3 server — the client warns about
# the mismatch on every connection — and cannot install `chromadb` at all. Two of
# the four arms were blocked by an interpreter nobody chose.
#
# Fixing that by installing a newer Python on the host would have moved the
# problem, not removed it: the next machine has a different one. The harness is a
# measurement instrument, so it gets pinned exactly like the things it measures.
#
# WHAT IS AND IS NOT IN HERE
# --------------------------
# Dependencies only. The benchmark code is MOUNTED at run time (`-v`), so editing a
# runner does not mean rebuilding an image — and the image cannot drift from the
# repo, because it holds none of it.
#
# REACHING THE ENGINES
# --------------------
# Engine containers publish their ports on the host. From inside this one the host
# is `host.docker.internal` (the runner passes `--add-host` on Linux, where it is
# not automatic). `BENCH_ENGINE_HOST` carries it to the adapters, which default to
# 127.0.0.1 for a runner invoked directly on the host.
FROM python:3.12-slim-bookworm

# libpq for psycopg2-binary's runtime; git so a runner can stamp the commit it ran.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /bench

# Dependencies first so a code change never invalidates this layer. The pins are
# `requirements.txt` verbatim — the file the repo already treats as the record of
# what the published numbers ran against.
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# The minimal xyzDB client is stdlib-only and ships in the repo; it arrives on the
# mount with everything else. PYTHONPATH names both roots so a script can be run
# as `python run_x.py` from /bench with no sys.path surgery.
ENV PYTHONPATH=/bench:/client \
    PYTHONUNBUFFERED=1 \
    BENCH_ENGINE_HOST=host.docker.internal

ENTRYPOINT ["python"]
