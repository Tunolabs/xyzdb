# Pinned rival images — the single source of truth for this harness.
#
# WHY THIS FILE EXISTS
# --------------------
# The v1 matrix ran against `qdrant/qdrant:latest`, `chromadb/chroma:latest` and
# `pgvector/pgvector:pg18`. None is a pin: `:latest` moves, and `:pg18` floats
# between patch releases. Worse, the per-cell provenance stamp recorded the xyzDB
# image precisely and the rivals not at all — grep across the 1106 published
# result files finds `xyzdb_image` in 825 of them and zero rival version fields.
# So the published numbers cannot be reproduced (they ran against whatever
# `:latest` resolved to that day, unrecorded), any before/after between matrices
# moves two variables at once, and the frozen HNSW tuning stopped corresponding
# to the binary it was tuned against.
#
# Same defect class as the `rand` caret in the native bench, where a `cargo
# update` could remap seed -> dataset and invalidate the golden in silence. Here
# it is a `docker pull` doing it to a rival engine.
#
# HOW TO USE IT
# -------------
#   . "$(dirname "$0")/images.env"     # or an equivalent path
#   require_pinned_images              # aborts unless every ref is digest-pinned
#
# Every runner must source this. `require_pinned_images` is the negative control:
# a runner that forgets dies with a message instead of silently pulling `:latest`,
# so runner number 18 cannot quietly reopen the hole.
#
# HOW THESE WERE CHOSEN (2026-08-01)
# ----------------------------------
# Not from memory. `:latest` was resolved on the day and the digest it pointed at
# was pinned — that IS the current stable, by construction. Verified not to be a
# pre-release: qdrant `:latest` maps to the `v1.18.3` tag, and chroma `:latest`
# maps to `1.5.9` (chroma also publishes `1.5.10.devNNN` builds, but `:latest`
# does not track them). `pgvector:pg18` was resolved the same way rather than
# trusted, since it floats between patches too.
#
# The readable versions were read from the live engine, not from the tag:
#   pg      docker exec … psql -tAc "SELECT version();" + the vector extversion
#   qdrant  GET /                       -> {"version":"1.18.3", …}
#   chroma  chroma --version            (see the caveat below)
#
# CHROMA REPORTS THREE DIFFERENT NUMBERS — read the digest, not the version
# ------------------------------------------------------------------------
#   registry tag           1.5.9
#   `chroma --version`     1.4.4
#   GET /api/v2/version    "1.0.0"   (this is the API version, not the product)
# and `GET /api/v1/version` — the endpoint you would reach for first — now
# answers `{"error":"Unimplemented","message":"The v1 API is deprecated"}`.
# Chroma ships as a Rust binary now, so there is no python package to interrogate
# either. The digest is the only unambiguous identifier for what ran; the version
# strings below are for the reader, and chroma's are recorded as they disagree
# rather than picking whichever looks tidiest.

# ─── Digest pins (authoritative) ─────────────────────────────────────────────
export IMG_PG="pgvector/pgvector@sha256:691673308c99d2161ba298736f3147f1f22d79de2fb7ec93ae9b4afcab870b62"
export IMG_QDRANT="qdrant/qdrant@sha256:0bd98fa7977f1e75694779359ca4e212822e5a71334e28421182f72f209d5286"
export IMG_CHROMA="chromadb/chroma@sha256:1e0b73a187a28757c572acba508c46f48c9e8b0acaf5c20e6d95cdedce1acdf6"

# ─── Readable versions (for the reader; the digest is what identifies the run) ─
export VER_PG="PostgreSQL 18.4 (Debian 18.4-1.pgdg12+1) + pgvector 0.8.6 [tag 0.8.6-pg18-bookworm]"
export VER_QDRANT="qdrant 1.18.3 (commit db8fa43fcb6aedec1e739487e17a99731b74590a) [tag v1.18.3]"
export VER_CHROMA="chroma tag 1.5.9 / binary self-reports 1.4.4 / HTTP api 1.0.0 — see the caveat in images.env"

# Resolution date, so a future reader knows how old these pins are.
export IMAGES_PINNED_ON="2026-08-01"

# ─── The negative control ────────────────────────────────────────────────────
# Asserts the SHAPE (`@sha256:`), not merely that the variable is set. That
# catches both "the runner never sourced this file" and "someone put a moving tag
# back in". A guard that only checked for a non-empty value would pass on
# `qdrant/qdrant:latest`, which is exactly the state it exists to prevent.
require_pinned_images() {
    _rpi_bad=0
    for _rpi_v in IMG_PG IMG_QDRANT IMG_CHROMA; do
        eval "_rpi_val=\${$_rpi_v:-}"
        case "$_rpi_val" in
            *@sha256:*) : ;;
            "")  echo "FATAL: $_rpi_v is unset — this runner did not source images.env" >&2
                 _rpi_bad=1 ;;
            *)   echo "FATAL: $_rpi_v is not digest-pinned: '$_rpi_val'" >&2
                 echo "       Rival images must be pinned by digest; a tag moves under you." >&2
                 _rpi_bad=1 ;;
        esac
    done
    if [ "$_rpi_bad" != 0 ]; then
        echo "       Fix: source images.env and use \$IMG_PG / \$IMG_QDRANT / \$IMG_CHROMA." >&2
        return 1
    fi
    return 0
}
